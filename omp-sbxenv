#!/usr/bin/env bash
###############################################################################
# omp-sbxenv - EXPERIMENTAL launcher built on `sbx env` and .sbxenv.yaml
# (sbx v0.39+; Docker marks `sbx env` experimental too).
#
#   omp-sbxenv                 create if needed, then attach
#   omp-sbxenv --new           remove and recreate
#   omp-sbxenv --version       passthrough omp flags
#   omp-sbxenv "fix the bug"   one-shot prompt
#
# Use this for scripted or CI runs. For interactive work prefer omp-sbx: this
# gives up three of its behaviors.
#   - no recovery cascade after a force-quit, just create-or-reuse
#   - no ~/.config/gh forwarding: a static file cannot skip a mount that some
#     hosts lack, and sbx prompts (so CI hangs) on a missing directory
#   - `sbx env run` on an existing environment only re-applies env and MCP
#     changes, so other .sbxenv.yaml edits need --new
###############################################################################
set -euo pipefail

SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  case "$SCRIPT_PATH" in /*) ;; *) SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH" ;; esac
done
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
KIT_DIR="${OMP_SBX_KIT:-$REPO_DIR/sbx-kit}"

if [ -t 2 ]; then
  C_DIM=$'\033[2m'; C_RED=$'\033[31m'; C_RST=$'\033[0m'
else
  C_DIM=''; C_RED=''; C_RST=''
fi
log() { printf '%s\n' "$*" >&2; }

# shellcheck source=sbx-preflight.sh
source "$REPO_DIR/sbx-preflight.sh"
ensure_sbx "omp-sbxenv"

if [ ! -d "$HOME/.omp" ]; then
  log "${C_RED}omp-sbxenv: host config dir not found: $HOME/.omp${C_RST}"
  exit 1
fi

# Values referenced by ${VAR} in sbx-kit/.sbxenv.yaml.
export OMP_SBXENV_KIT_DIR="$KIT_DIR"
export OMP_SBXENV_WORKSPACE="$(pwd)"
export OMP_SBXENV_NAME="omp-$(basename "$OMP_SBXENV_WORKSPACE" | tr -cd '[:alnum:]_-')"

# ── Parse flags ──────────────────────────────────────────────────────────────
FORCE_NEW=false
OMP_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --new) FORCE_NEW=true ;;
    *)     OMP_ARGS+=("$arg") ;;
  esac
done
if [ ${#OMP_ARGS[@]} -gt 0 ]; then set -- "${OMP_ARGS[@]}"; else set --; fi

if $FORCE_NEW; then
  log "${C_DIM}omp-sbxenv: removing existing environment '$OMP_SBXENV_NAME' (--new)${C_RST}"
  sbx env rm "$KIT_DIR" --force >/dev/null 2>&1 || true
fi

# ── Launch ───────────────────────────────────────────────────────────────────
if [ "$#" -eq 0 ] && [ -t 0 ]; then
  # Interactive TUI: `sbx env run` creates (if needed) and attaches.
  exec sbx env run "$KIT_DIR"
else
  # Ignore a failed create: it means the environment already exists, and
  # `sbx env exec` starts it either way.
  sbx env create "$KIT_DIR" >/dev/null 2>&1 || true
  exec sbx env exec "$KIT_DIR" -- omp "$@"
fi
