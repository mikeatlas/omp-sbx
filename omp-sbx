#!/usr/bin/env bash
###############################################################################
# omp-sbx - launch omp inside a Docker sbx sandbox.
#
#   omp-sbx                 reconnect to this directory's sandbox, or create it
#   omp-sbx --new           destroy it and start fresh
#   omp-sbx --version       passthrough omp flags
#   omp-sbx "fix the bug"   one-shot prompt
#
# The sandbox name comes from the directory name, so a second run from the
# same cwd resumes the same omp session. $PWD is the workspace; $HOME/.omp
# is mounted at its host path and symlinked into place by omp-init.sh.
###############################################################################
set -euo pipefail

# Follow symlinks so the repo root resolves from a launcher on $PATH.
SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  case "$SCRIPT_PATH" in /*) ;; *) SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH" ;; esac
done
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
KIT_DIR="${OMP_SBX_KIT:-$REPO_DIR/sbx-kit}"
TEMPLATE="${OMP_SBX_TEMPLATE:-omp-sbx:latest}"

# Colors (only when stderr is a tty)
if [ -t 2 ]; then
  C_DIM=$'\033[2m'; C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_BOLD=$'\033[1m'; C_RST=$'\033[0m'
else
  C_DIM=''; C_CYAN=''; C_GREEN=''; C_YELLOW=''; C_RED=''; C_BOLD=''; C_RST=''
fi
log() { printf '%s\n' "$*" >&2; }

# ── Parse flags ──────────────────────────────────────────────────────────────
FORCE_NEW=false
SKIP_PAUSE=false
OMP_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --new)  FORCE_NEW=true ;;
    --yes|-y) SKIP_PAUSE=true ;;
    *)      OMP_ARGS+=("$arg") ;;
  esac
done
if [ ${#OMP_ARGS[@]} -gt 0 ]; then set -- "${OMP_ARGS[@]}"; else set --; fi

# ── Preflight ────────────────────────────────────────────────────────────────
# shellcheck source=sbx-preflight.sh
source "$REPO_DIR/sbx-preflight.sh"
ensure_sbx "omp-sbx"

if [ ! -d "$HOME/.omp" ]; then
  log "${C_RED}omp-sbx: host config dir not found: $HOME/.omp${C_RST}"
  exit 1
fi

# Mounting the host gh session is what makes `gh` and `git push` work inside
# the sandbox.
MOUNTS=("$HOME/.omp")
if [ -d "$HOME/.config/gh" ]; then
  MOUNTS+=("$HOME/.config/gh")
fi

# In a linked worktree, .git is a file pointing at an absolute host path
# inside the main repo. Mount the main repo too, at that same path, or git
# reports "fatal: not a git repository". It needs rw for refs and objects.
if [ -f "$(pwd)/.git" ]; then
  GIT_COMMON_DIR="$(git -C "$(pwd)" rev-parse --git-common-dir 2>/dev/null || true)"
  if [ -n "$GIT_COMMON_DIR" ]; then
    case "$GIT_COMMON_DIR" in
      /*) ;;
      *) GIT_COMMON_DIR="$(pwd)/$GIT_COMMON_DIR" ;;
    esac
    MAIN_REPO_ROOT="$(cd "$(dirname "$GIT_COMMON_DIR")" && pwd)"
    if [ "$MAIN_REPO_ROOT" != "$(pwd)" ] && [ -d "$MAIN_REPO_ROOT" ]; then
      MOUNTS+=("$MAIN_REPO_ROOT")
    fi
  fi
fi

# ── Sandbox name (per-directory) ─────────────────────────────────────────────
WORKDIR="$(pwd)"
SANDBOX_NAME="omp-$(basename "$WORKDIR" | tr '_' '-' | tr -cd '[:alnum:]_-')"

sandbox_exists() {
  # Exact match on the first column: omp-foo must not match omp-foo-parallel2.
  sbx ls 2>/dev/null | awk -v name="$1" 'NR>1 && $1 == name {found=1} END {exit !found}'
}

if $FORCE_NEW && sandbox_exists "$SANDBOX_NAME"; then
  log "${C_DIM}omp-sbx: removing existing sandbox '$SANDBOX_NAME' (--new)${C_RST}"
  sbx rm -f "$SANDBOX_NAME" >/dev/null 2>&1 || true
fi

EXISTS=false
sandbox_exists "$SANDBOX_NAME" && EXISTS=true

# ── Banner ───────────────────────────────────────────────────────────────────
log "${C_BOLD}${C_CYAN}╭─ omp-sbx ─────────────────────────────────────────────────╮${C_RST}"
log "${C_CYAN}│${C_RST} template  : ${TEMPLATE}"
log "${C_CYAN}│${C_RST} workspace : ${WORKDIR}  ${C_DIM}→ /home/agent/workspace${C_RST}"
log "${C_CYAN}│${C_RST} config    : ${HOME}/.omp  ${C_DIM}(shared, via symlink)${C_RST}"
if [ -d "$HOME/.config/gh" ]; then
  log "${C_CYAN}│${C_RST} gh session: ${HOME}/.config/gh  ${C_DIM}(shared, via symlink)${C_RST}"
fi
if [ -n "${MAIN_REPO_ROOT:-}" ]; then
  log "${C_CYAN}│${C_RST} main repo : ${MAIN_REPO_ROOT}  ${C_DIM}(linked worktree, mounted rw)${C_RST}"
fi
log "${C_CYAN}│${C_RST} sandbox   : ${SANDBOX_NAME}  ${C_DIM}($([ "$EXISTS" = true ] && echo 'resuming' || echo 'new'))${C_RST}"
if [ "$#" -eq 0 ]; then
  log "${C_CYAN}│${C_RST} mode      : ${C_GREEN}interactive TUI${C_RST}"
else
  log "${C_CYAN}│${C_RST} mode      : ${C_GREEN}omp $*${C_RST}"
fi
log "${C_BOLD}${C_CYAN}╰─ starting omp inside the sbx sandbox ──────────────────────╯${C_RST}"
log ""
# ── Launch ───────────────────────────────────────────────────────────────────
# Interactive mode creates and attaches in separate steps, with a pause in
# between, because attaching hands the screen to omp and any sbx warning from
# create scrolls away unread.
if [ "$#" -eq 0 ] && [ -t 0 ]; then
  if ! $EXISTS; then
    # `sbx ls` can omit a stopped sandbox, so a name collision here means the
    # sandbox does exist (a force-quit left it stopped) and attaching will
    # find it. Any other failure is real.
    if create_out="$(sbx create --kit "$KIT_DIR" --template "$TEMPLATE" --name "$SANDBOX_NAME" \
        omp "$WORKDIR" "${MOUNTS[@]}" 2>&1)"; then
      if [ -n "$create_out" ]; then printf '%s\n' "$create_out" >&2; fi
      # Let the startup hook finish its symlinks.
      sleep 2
    else
      if [ -n "$create_out" ]; then printf '%s\n' "$create_out" >&2; fi
      if printf '%s' "$create_out" | grep -qiE 'already exists|given new workspaces'; then
        log "${C_DIM}omp-sbx: sandbox already exists (stopped?), will re-attach${C_RST}"
      else
        log "${C_RED}omp-sbx: failed to create sandbox${C_RST}"
        exit 1
      fi
    fi
  fi

  if ! $SKIP_PAUSE; then
    log ""
    log "${C_GREEN}Press any key to launch omp (or --yes to skip this)...${C_RST}"
    read -rsn1 < /dev/tty
    log ""
  fi

  # --kit is required on every run: "omp" is not a built-in sbx agent. A
  # force-quit can wedge the agent process, so escalate on failure - restart
  # the sandbox, then recreate it. The conversation resumes either way,
  # because session state lives in the shared ~/.omp mount.
  if ! sbx run --kit "$KIT_DIR" --name "$SANDBOX_NAME" 2>&1; then
    log "${C_DIM}omp-sbx: re-attach failed; restarting sandbox...${C_RST}"
    sbx stop "$SANDBOX_NAME" >/dev/null 2>&1 || true
    if ! sbx run --kit "$KIT_DIR" --name "$SANDBOX_NAME" 2>&1; then
      log "${C_DIM}omp-sbx: sandbox unresponsive, recreating...${C_RST}"
      sbx rm -f "$SANDBOX_NAME" >/dev/null 2>&1 || true
      if ! sbx create --kit "$KIT_DIR" --template "$TEMPLATE" --name "$SANDBOX_NAME" \
          omp "$WORKDIR" "${MOUNTS[@]}" 2>&1; then
        log "${C_RED}omp-sbx: failed to create sandbox${C_RST}"
        exit 1
      fi
      sleep 2
      exec sbx run --kit "$KIT_DIR" --name "$SANDBOX_NAME"
    fi
  fi
else
  if ! $EXISTS; then
    # Ignore a failed create: it usually means a stopped sandbox already holds
    # the name, and sbx exec starts a stopped sandbox anyway. Real errors show
    # up there.
    if ! sbx create --kit "$KIT_DIR" --template "$TEMPLATE" --name "$SANDBOX_NAME" \
        omp "$WORKDIR" "${MOUNTS[@]}" >/dev/null 2>&1; then
      :
    else
      sleep 2
    fi
  fi
  # Go through omp-init.sh, as an interactive session does, so a one-shot
  # command cannot skip the workspace setup.
  exec sbx exec -w /home/agent "$SANDBOX_NAME" omp-init.sh "$@"
fi
