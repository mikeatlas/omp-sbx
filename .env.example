# omp-sbx build + runtime configuration — copy to .env and adjust
# (the .env file is gitignored and sourced by both build.sh and omp-sbx)

# Install pi-morphllm-plugin in the sandbox image (1 = yes, 0 = no)
# Default: 0 (opt-in). Set to 1 to enable Morph tools.
INSTALL_MORPH_PLUGIN=0

# Native Morph API key (optional — enables the full Morph toolset).
# Get one at https://morphllm.com. When set, the startup script uses
# api.morphllm.com as the endpoint and all tools work (FastApply,
# WarpGrep, compaction). When absent, falls back to your OpenRouter
# key (morph_fastapply only; WarpGrep/compaction need Morph's API).
# MORPH_API_KEY=sk-...
