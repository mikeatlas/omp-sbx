{
  "apiKey": "multiple",
  "apiKeyFile": "~/.pi/morph/morph.env",
  "apiKeyStrategy": "round-robin",
  "baseUrl": "https://api.morphllm.com",
  "editEnabled": true,
  "warpgrepEnabled": true,
  "warpgrepGithubEnabled": true,
  "contextResearchEnabled": true,
  "browserUrlEnabled": false,
  "previewPrEnabled": false,
  "autoCompactEnabled": true,
  "allowReadonlyAgents": false,
  "routing": {
    "editMode": "prefer",
    "codebaseSearchMode": "prefer",
    "githubSearchMode": "prefer",
    "fallbackToNativeTools": true
  },
  "fastModel": {
    "enabled": true,
    "model": "morph-qwen36-27b",
    "timeoutMs": 30000,
    "contextResearchDistillationEnabled": true,
    "repairSuggestionsEnabled": true
  },
  "statsDashboard": {
    "enabled": false
  },
  "compactContextThreshold": 0.85,
  "compactPreserveRecent": 1,
  "compactRatio": 0.3,
  "timeoutMs": 30000,
  "warpGrepTimeoutMs": 60000,
  "compactTimeoutMs": 60000
}
